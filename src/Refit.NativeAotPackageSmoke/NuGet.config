<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The packages packed from this checkout. See README.md for the pack commands. -->
    <add key="refit-local" value="obj/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Refit packages come only from the local feed, so a published version on nuget.org can never stand in for them. -->
    <packageSource key="refit-local">
      <package pattern="Refit" />
      <package pattern="Refit.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
