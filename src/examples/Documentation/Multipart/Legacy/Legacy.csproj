<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- All methods in this JIT-only example deliberately use the reflection request builder. -->
    <RefitGeneratedRequestBuilding>false</RefitGeneratedRequestBuilding>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="RefitGeneratedRequestBuilding" />
    <ProjectReference Include="../../../../Refit/Refit.csproj" />
    <ProjectReference Include="../../../../Refit.Reflection/Refit.Reflection.csproj" />
    <ProjectReference Include="../../../../InterfaceStubGenerator.Roslyn48/InterfaceStubGenerator.Roslyn48.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../../Refit.Analyzers.Roslyn48/Refit.Analyzers.Roslyn48.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Include="../../Common/SampleCheck.cs" Link="SampleCheck.cs" />
    <Compile Include="../CapturedPart.cs" Link="CapturedPart.cs" />
    <Compile Include="../MultipartHandler.cs" Link="MultipartHandler.cs" />
    <Compile Include="../MultipartJsonContext.cs" Link="MultipartJsonContext.cs" />
    <Compile Include="../UploadMetadata.cs" Link="UploadMetadata.cs" />
  </ItemGroup>
</Project>
